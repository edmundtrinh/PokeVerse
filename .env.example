# Copy to .env (git-ignored) and restart Metro with `npx expo start --clear`.

# Optional API key from https://dev.pokemontcg.io (free). Without it the TCG API still works
# but returns more 5xx errors and has lower rate limits.
EXPO_PUBLIC_TCG_API_KEY=

# Set to 1 to skip the network and use the bundled sample cards (src/data/tcgFixtures.json)
EXPO_PUBLIC_TCG_OFFLINE=
